# Copy to .env, restrict permissions to 600, replace placeholders.
PORT=3000
BIND_ADDRESS=127.0.0.1
# Exact browser origin, no trailing slash; HTTPS is required for remote access.
PUBLIC_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
# Generate with npm run password:hash (see README).
ADMIN_PASSWORD_HASH=replace-with-generated-scrypt-hash
# false ONLY for localhost HTTP development / SSH forwarding.
COOKIE_SECURE=false
# Optional; treated as a secret and never returned to the browser.
N8N_WEBHOOK_URL=
APPS_CONFIG_PATH=./config/apps.json
DATA_DIR=./data
DOCKER_SOCKET=/var/run/docker.sock
HOST_PROC=/proc
HOST_SYS=/sys
HOST_ROOT=/
TEMPERATURE_WARN=80
DISK_WARN_PERCENT=90
# Compose only: id -u; id -g; stat -c '%g' /var/run/docker.sock
PUID=1000
PGID=1000
DOCKER_GID=replace-with-docker-socket-group-id
