{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "outDir": "dist",
    "rootDir": ".", "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["apps/server/**/*.ts", "shared/**/*.ts"]
}
